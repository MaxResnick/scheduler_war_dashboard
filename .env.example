# Hostname without protocol (uses native protocol with TLS on port 9440).
CLICKHOUSE_HOST=cluster.clickhouse.mainnet.jito.wtf
CLICKHOUSE_PORT=9440
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=your_username
CLICKHOUSE_PASSWORD=your_password
ETH_STAKERS_CLICKHOUSE_TABLE=eth_stakers_snapshots
# Scheduler War API (NestJS backend)
SCHEDULER_API_BASE_URL=http://127.0.0.1:3100
SCHEDULER_API_KEY=change-me
# Dune API
DUNE_API_KEY=your_dune_api_key
DUNE_QUERY_ID=1234567
# DUNE_QUERY_PERFORMANCE=medium
# DUNE_POLL_INTERVAL_SECONDS=10
# DUNE_MAX_WAIT_SECONDS=600
# DUNE_TLS_VERIFY=true
# Set to false to allow self-signed certs. Leave unset to enforce TLS verification.
# CLICKHOUSE_TLS_REJECT_UNAUTHORIZED=true
# Provide absolute paths to client certificate materials when mTLS is required.
# CLICKHOUSE_TLS_CERT_PATH=/absolute/path/to/client-cert.pem
# CLICKHOUSE_TLS_KEY_PATH=/absolute/path/to/client-key.pem
# Optional custom CA bundle for validating the server certificate chain.
# CLICKHOUSE_TLS_CA_PATH=/absolute/path/to/ca.pem

# Validators.app API token for fetching validator names.
# Get your API token at https://www.validators.app/users/edit (requires account)
# VALIDATORS_APP_API_TOKEN=your_api_token
